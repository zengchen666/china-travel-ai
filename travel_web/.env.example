# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）

# Django
SECRET_KEY=please-change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=*

# 数据库配置
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306

# DeepSeek API（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 百度地图 API（https://lbsyun.baidu.com/，需启用 JavaScript API）
BAIDU_MAP_AK=xxxxxxxxxxxxxxxxxxxxxxxx

# RAG 向量索引存储路径（可选；默认 ~/.cache/travel_rag_storage，
# ChromaDB 对非 ASCII 路径兼容性差，中文目录下务必保持默认或指定纯英文路径）
# RAG_STORAGE=D:/travel_rag_storage
